<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Fills a table through the latest published version of the package, which Dependabot keeps
    current, so that the upgrade tests migrate data that release really wrote rather than data
    shaped like it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Community.OpenIddict.AmazonDynamoDB" Version="4.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.14" />
  </ItemGroup>

</Project>
